[Unit]
Description=SourceOS Truth Plane tick (v0)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

# NOTE: packaging should install tools under /usr/lib/sourceos/tools.
# This unit assumes that layout.
Environment=SOURCEOS_STORE_ROOT=/var/lib/sourceos
ExecStart=/usr/bin/env python3 /usr/lib/sourceos/tools/sourceos_truth_plane_tick.py --store-root $SOURCEOS_STORE_ROOT

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sourceos

[Install]
WantedBy=multi-user.target
